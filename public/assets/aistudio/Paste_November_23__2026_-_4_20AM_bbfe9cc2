<script data-purpose="equalizer-interaction">
    // Simple dynamic subtle height pulsation for waveform fidelity
    document.addEventListener("DOMContentLoaded", () => {
      const bars = document.querySelectorAll('.wave-bar');
      setInterval(() => {
        bars.forEach(bar => {
          const randomFactor = Math.random() * 0.4 + 0.8;
          const currentHeight = parseInt(window.getComputedStyle(bar).height);
          if (currentHeight > 0) {
            bar.style.transform = `scaleY(${randomFactor.toFixed(2)})`;
          }
        });
      }, 350);
    });
  </script>
